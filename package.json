{
  "name": "omnisync",
  "version": "1.0.1",
  "description": "Sincronización privada de bóvedas en tiempo real y punto a punto (P2P) para Obsidian con cifrado de extremo a extremo.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test:minimax": "esbuild tests/verify-minimax.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-minimax.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/verify-minimax.mjs",
    "test:security": "esbuild tests/test-security.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-security.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-security.mjs",
    "test:nostr": "esbuild tests/test-nostr-mailbox.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-nostr-mailbox.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-nostr-mailbox.mjs",
    "test:mysecret": "esbuild tests/test-mysecret-compat.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-mysecret-compat.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-mysecret-compat.mjs",
    "test:delta": "esbuild tests/test-delta-patch.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-delta-patch.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-delta-patch.mjs",
    "test:base": "esbuild tests/test-base-snapshot-store.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-base-snapshot-store.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-base-snapshot-store.mjs",
    "test:nostr-delta": "esbuild tests/test-nostr-delta-mailbox.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-nostr-delta-mailbox.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-nostr-delta-mailbox.mjs",
    "test:blossom": "esbuild tests/test-blossom.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-blossom.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-blossom.mjs",
    "test:realtime-security": "esbuild tests/test-realtime-security.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-realtime-security.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-realtime-security.mjs",
    "test:cloudflare-worker": "esbuild tests/test-cloudflare-worker.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-cloudflare-worker.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-cloudflare-worker.mjs",
    "test:cloudflare-mailbox": "esbuild tests/test-cloudflare-mailbox.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-cloudflare-mailbox.mjs --alias:obsidian=./tests/obsidian-stub.ts --alias:cloudflare:workers=./tests/cloudflare-workers-stub.ts --external:@codemirror/state --external:@codemirror/view --external:node:sqlite --log-level=warning && node --no-warnings node_modules/.cache/test-cloudflare-mailbox.mjs",
    "build:templates": "node scripts/generate-cloudflare-templates.mjs",
    "test:cloudflare-allinone": "esbuild tests/test-cloudflare-allinone-worker.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-cloudflare-allinone-worker.mjs --alias:obsidian=./tests/obsidian-stub.ts --alias:cloudflare:workers=./tests/cloudflare-workers-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-cloudflare-allinone-worker.mjs",
    "test:pairing": "esbuild tests/test-pairing-session.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-pairing-session.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-pairing-session.mjs",
    "test:pairing-channel": "esbuild tests/test-pairing-channel.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-pairing-channel.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-pairing-channel.mjs",
    "test:i18n": "esbuild tests/test-i18n.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-i18n.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-i18n.mjs",
    "test:auditor": "esbuild tests/test-auditor-regression.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-auditor-regression.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-auditor-regression.mjs",
    "test:bughunt": "esbuild tests/test-bughunt-regression.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-bughunt-regression.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-bughunt-regression.mjs",
    "test:dual-path": "esbuild tests/test-dual-path-regression.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-dual-path-regression.mjs --banner:js='import { createRequire as __cr } from \"module\"; const require = __cr(import.meta.url);' --alias:obsidian=./tests/obsidian-stub.ts --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-dual-path-regression.mjs",
    "test:core": "node tests/test-omnisync.mjs",
    "test:distribution": "esbuild tests/test-distribution-artifact.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-distribution-artifact.mjs --alias:obsidian=./tests/obsidian-stub.ts --external:esbuild --external:builtin-modules --external:@codemirror/state --external:@codemirror/view --log-level=warning && node node_modules/.cache/test-distribution-artifact.mjs",
    "test": "npm run test:minimax && npm run test:security && npm run test:nostr && npm run test:mysecret && npm run test:delta && npm run test:base && npm run test:nostr-delta && npm run test:blossom && npm run test:realtime-security && npm run test:cloudflare-worker && npm run test:cloudflare-allinone && npm run test:cloudflare-mailbox && npm run test:i18n && npm run test:pairing && npm run test:pairing-channel && npm run test:core && npm run test:bughunt && npm run test:auditor && npm run test:dual-path && npm run test:distribution",
    "package:stable": "npm run build && node scripts/package-stable.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit:deps": "osv-scanner scan -r . --no-ignore",
    "audit:secrets": "gitleaks detect --source . --no-git -v",
    "audit:static": "semgrep scan --config auto . --exclude node_modules --exclude main.js --exclude zip",
    "audit": "npm run typecheck && npm run lint && npm run audit:secrets && npm run audit:static && npm run audit:deps",
    "sync:github": "bash scripts/sync-to-github.sh"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "p2p",
    "webrtc",
    "e2ee",
    "real-time"
  ],
  "author": "Anthony Rios Licea (abismalmx) <abismalmx.splurge748@8shield.net>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.18.0",
    "@types/qrcode": "^1.5.5",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "nostr-tools": "^2.25.2",
    "qrcode": "^1.5.4"
  }
}
